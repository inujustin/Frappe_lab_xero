{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Frappe",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/frappe-bench",
          "remoteRoot": "${workspaceFolder}/frappe-bench"
        }
      ],
      "justMyCode": false
    }
  ]
}
