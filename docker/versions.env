# One source of versions. The Dockerfile and compose file read this file; the start-up script
# downloads the apps at the branches below. After a change: docker compose up --build -d
# (a branch change only applies to an empty frappe-bench/ folder).
#
# Where each value comes from (checked 2026-10-08):
#   PYTHON_VERSION   frappe version-16 pyproject.toml: requires-python = ">=3.14,<3.15"
#   NODE_VERSION     frappe version-16 package.json: "engines": {"node": ">=24"}
#   MARIADB_VERSION  frappe_docker devcontainer-example/docker-compose.yml: mariadb:11.8
#   REDIS_VERSION    same file uses the unpinned tag redis:alpine; pin a number here once you choose one
#   CRM_BRANCH       crm main pyproject.toml: frappe = ">=15.0.0,<17.0.0"
#   BENCH_VERSION    latest frappe-bench on PyPI, and the version already on this host
PYTHON_VERSION=3.14
NODE_VERSION=24
MARIADB_VERSION=11.8
REDIS_VERSION=alpine
FRAPPE_BRANCH=version-16
ERPNEXT_BRANCH=version-16
CRM_BRANCH=main
BENCH_VERSION=5.31.0
