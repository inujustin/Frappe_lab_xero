# Copy to docker/.env and set the password. docker/.env is yours: agents never read it.
MARIADB_ROOT_PASSWORD=<DB_ROOT_PASSWORD>
# Password of the site's Administrator user; used only when the site is created.
ADMIN_PASSWORD=<ADMIN_PASSWORD>
SITE_NAME=lab.localhost
# Apps to install on the site, space separated. Leave empty to install every app in the bench.
INSTALL_APPS=
# Must equal `id -u` and `id -g` on the host, or files in frappe-bench/ get the wrong owner.
HOST_UID=1000
HOST_GID=1000
# Absolute path of the bench on the host. Leave unset to use <project root>/frappe-bench
# (works when compose is run from the project root). The container mounts it at the same path.
# BENCH_DIR=/absolute/path/to/frappe-bench
# 1 = debug mode: only the web server runs, under debugpy on port 5678. No background jobs,
# scheduler, realtime or reload on Python edits while it is on. Leave 0 for normal work.
LAB_DEBUG=0
# 1 = tests may run on the site: the start-up script sets allow_tests on it. Tests write test
# records into this site's database; set 0 on a site whose data you care about.
LAB_ALLOW_TESTS=1
WEB_PORT=8000
SOCKETIO_PORT=9000
